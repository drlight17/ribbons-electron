{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ribbons Screensaver",
  "version": "1.0.2",
  "identifier": "com.electron.ribbons-tauri",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/translations/": "translations/",
      "../ui/icon.png": "icon.png",
      "../ui/icon.ico": "icon.ico",
      "../ui/iconPaused.png": "iconPaused.png",
      "../ui/iconPaused.ico": "iconPaused.ico",
      "../ui/iconTemplate.png": "iconTemplate.png",
      "../ui/iconTemplatePaused.png": "iconTemplatePaused.png"
    },
    "copyright": "AGPLv3 \u00a92026 Yuri Samoilov",
    "category": "Entertainment",
    "shortDescription": "Windows-like Ribbons Screensaver",
    "longDescription": "Famous Ribbons Screensaver made with JS and Tauri (Rust) for multi platform support.",
    "homepage": "https://ribbons.drlight.fun/",
    "publisher": "drlight17",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "desktopTemplate": "linux/ribbons.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/ribbons.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.6"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/drlight17/ribbons-tauri/releases/latest/download/latest.json"
      ],
      "pubkey": "RWS46skHxltvsQ4F/fHmBlGfhwyWgV46S3FY56Ys8f8FmrieuhJXH8GM",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
