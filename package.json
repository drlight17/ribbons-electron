{
  "name": "ribbons-electron",
  "desktopName": "com.electron.ribbons-electron.desktop",
  "productName": "Ribbons screensaver",
  "description": "Famous Ribbons screensaver made with js and Electron wrapped for multi platform support",
  "keywords": [
    "windows",
    "ribbons",
    "screensaver",
    "electron"
  ],
  "type": "module",
  "icon": "icon.png",
  "main": "./main.js",
  "version": "1.0.1",
  "author": "Yuri Samoilov <root@drlight.fun>",
  "homepage": "https://github.com/drlight17/ribbons-electron",
  "apiLink": "https://api.github.com/repos/drlight17/ribbons-electron",
  "build": {
    "appId": "com.electron.ribbons-electron",
    "productName": "Ribbons screensaver",
    "artifactName": "Ribbons.screensaver-${version}.${ext}",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "drlight17",
      "repo": "ribbons-electron"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true
    },
    "msi": {
      "oneClick": true,
      "perMachine": true
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "artifactName": "Ribbons.screensaver-${version}-mac-${arch}.${ext}",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "asarUnpack": [
        "./icon.png",
        "./iconPaused.png"
      ]
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "asarUnpack": [
        "./icon.ico",
        "./iconPaused.ico",
        "./UPDATE_BLOCK"
      ]
    },
    "linux": {
      "icon": "icon.icns",
      "category": "Multimedia",
      "syncDesktopName": true,
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "asarUnpack": [
        "./icon.png",
        "./iconPaused.png",
        "./UPDATE_BLOCK"
      ]
    }
  },
  "scripts": {
    "build-rpm": "touch UPDATE_BLOCK ; electron-builder --linux rpm ; rm -f UPDATE_BLOCK",
    "build-deb": "touch UPDATE_BLOCK ; electron-builder --linux deb ; rm -f UPDATE_BLOCK",
    "build-targz": "touch UPDATE_BLOCK ; electron-builder --linux tar.gz ; rm -f UPDATE_BLOCK",
    "build-AppImage": "electron-builder --linux AppImage",
    "build-exe": "electron-builder --windows nsis",
    "build-msi": "type nul > UPDATE_BLOCK ; electron-builder --win msi ; del /f UPDATE_BLOCK",
    "build-zip": "type nul > UPDATE_BLOCK ; electron-builder --windows zip ; del /f UPDATE_BLOCK",
    "build-zip-mac": "touch UPDATE_BLOCK ; electron-builder --mac zip ; rm -f UPDATE_BLOCK",
    "build-dmg": "touch UPDATE_BLOCK ; electron-builder --mac dmg ; rm -f UPDATE_BLOCK",
    "dist": "npm run build-rpm ; npm run build-deb ; npm run build-targz ; npm run build-AppImage ; npm run build-dmg ; npm run build-zip-mac ; npm run build-zip ; npm run build-msi ; npm run build-exe ",
    "start": "electron ."
  },
  "dependencies": {
    "@deepfocus/get-windows": "latest",
    "@electron/packager": "latest",
    "dbus-next": "latest",
    "electron-fetch": "latest",
    "electron-native-screenshare": "latest",
    "electron-prompt": "latest",
    "electron-store": "latest",
    "electron-updater": "^4.0.0",
    "glasstron": "latest",
    "node-desktop-idle-v2": "latest",
    "node-hid": "latest",
    "semver": "latest"
  },
  "devDependencies": {
    "electron": "^31",
    "electron-builder": "latest",
    "electron-rebuild": "^3.2.9"
  }
}
