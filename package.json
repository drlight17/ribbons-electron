{
  "name": "ribbons-electron",
  "desktopName": "com.electron.ribbons-electron.desktop",
  "productName": "Ribbons screensaver",
  "description": "Famous Ribbons screensaver made with js and Electron wrapped for multi platform support",
  "keywords": [
    "windows",
    "ribbons",
    "screensaver",
    "electron"
  ],
  "type": "module",
  "icon": "icon.png",
  "main": "./main.js",
  "version": "1.0.0-RC1",
  "author": "Yuri Samoilov <root@drlight.fun>",
  "homepage": "https://github.com/drlight17/ribbons-electron",
  "build": {
    "appId": "com.electron.ribbons-electron",
    "productName": "Ribbons screensaver",
    "artifactName": "Ribbons.screensaver-${version}.${ext}",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "drlight17",
      "repo": "ribbons-electron"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true
    },
    "msi": {
      "oneClick": true,
      "perMachine": true
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "artifactName": "Ribbons.screensaver-${version}-mac-${arch}.${ext}",
      "icon": "icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "asarUnpack": [
        "./icon.png",
        "./iconPaused.png"
      ]
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ],
      "asarUnpack": [
        "./icon.ico",
        "./iconPaused.ico"
      ]
    },
    "linux": {
      "icon": "icon.icns",
      "category": "Multimedia",
      "syncDesktopName": true,
      "target": [
        { "target": "tar.gz", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "asarUnpack": [
        "./icon.png",
        "./iconPaused.png"
      ]
    }
  },
  "scripts": {
    "build-rpm": "electron-builder --linux rpm",
    "build-deb": "electron-builder --linux deb",
    "build-targz": "electron-builder --linux tar.gz",
    "build-flatpak": "electron-builder --linux flatpak",
    "build-AppImage": "electron-builder --linux AppImage",
    "build-exe": "electron-builder --windows nsis",
    "build-msi": "electron-builder --windows msi",
    "build-zip": "electron-builder --windows zip",
    "build-dmg": "electron-builder --mac dmg",
    "dist": "electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "@deepfocus/get-windows": "latest",
    "@electron/packager": "latest",
    "dbus-next": "latest",
    "electron-fetch": "latest",
    "electron-native-screenshare": "latest",
    "electron-prompt": "latest",
    "electron-store": "latest",
    "node-desktop-idle-v2": "latest",
    "node-hid": "latest"
  },
  "devDependencies": {
    "electron": "^31",
    "electron-builder": "latest",
    "electron-rebuild": "^3.2.9"
  }
}
